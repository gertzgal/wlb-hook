{
  "description": "wlb-hook: gates prompts once today's work exceeds your budget",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit.py"],
            "timeout": 28,
            "statusMessage": "wlb-hook: checking your work-life balance"
          }
        ]
      }
    ]
  }
}
