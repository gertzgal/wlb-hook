{
  "description": "wlb-hook: example PreToolUse guard on Bash and UserPromptSubmit context injection",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/pre_tool_use.py"],
            "timeout": 10,
            "statusMessage": "wlb-hook: checking command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit.py"],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
